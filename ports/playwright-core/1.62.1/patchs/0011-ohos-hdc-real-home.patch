+
+/**
+ * The real home directory of the current user. hdc keeps its server state and
+ * authorization under HOME, so a caller that isolates HOME (test runners, task
+ * runners, sandboxes) makes hdc start a second server that has no device
+ * connection. os.userInfo() throws on openharmony without the compat shim, so
+ * fall back to the fixed per-user location HarmonyOS PC uses. Only an existing
+ * directory is returned.
+ */
+export const realUserHome = (): string | undefined => {
+  const candidates: string[] = [];
+  try {
+    candidates.push(os.userInfo().homedir);
+  } catch {
+  }
+  candidates.push('/storage/Users/currentUser');
+  for (const candidate of candidates) {
+    try {
+      if (candidate && fs.statSync(candidate).isDirectory())
+        return candidate;
+    } catch {
+    }
+  }
+  return undefined;
+};
+
+/**
+ * Environment for spawning hdc: the caller's environment with HOME pointed at
+ * the real user home, so hdc reuses the server and the authorization of the
+ * logged-in user. Returns undefined (inherit as is) when HOME is already the
+ * real home or the real home cannot be determined.
+ */
+export const hdcEnvironment = (): NodeJS.ProcessEnv | undefined => {
+  const home = realUserHome();
+  if (!home || home === process.env.HOME)
+    return undefined;
+  return { ...process.env, HOME: home };
+};
