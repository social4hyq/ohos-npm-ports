+/**
+ * Harmonybrew prefixes to look in, most specific first. HOMEBREW_PREFIX is not
+ * always forwarded (test runners and task runners pass a filtered
+ * environment), HOME may point at an isolated directory, and os.userInfo()
+ * throws on openharmony without the compat shim — so try all of them, ending
+ * with the fixed per-user location HarmonyOS PC uses.
+ */
+const harmonybrewPrefixes = (): string[] => {
+  const prefixes: string[] = [];
+  if (process.env.HOMEBREW_PREFIX)
+    prefixes.push(process.env.HOMEBREW_PREFIX);
+  try {
+    prefixes.push(path.join(os.userInfo().homedir, '.harmonybrew'));
+  } catch {
+  }
+  if (process.env.HOME)
+    prefixes.push(path.join(process.env.HOME, '.harmonybrew'));
+  prefixes.push('/storage/Users/currentUser/.harmonybrew');
+  return prefixes;
+};
+
+/**
+ * The hdc from the Harmonybrew ohos-sdk package, preferred over whatever hdc
+ * happens to be on PATH: it is the one the rest of the HarmonyOS PC toolchain
+ * uses and it does not depend on the caller's PATH.
+ */
+export const findHarmonybrewHdc = (): string | undefined => {
+  for (const prefix of harmonybrewPrefixes()) {
+    for (const relative of ['opt/ohos-sdk/toolchains/hdc', 'opt/ohos-sdk/bin/hdc']) {
+      const candidate = path.join(prefix, relative);
+      try {
+        fs.accessSync(candidate, fs.constants.X_OK);
+        return candidate;
+      } catch {
+      }
+    }
+  }
+  return undefined;
+};
+
+/**
+ * The host-side executable that starts the device browser. Device browsers
+ * have no local binary, so `BrowserType.executablePath()` returns the `hdc`
+ * binary instead of throwing "Browser is not supported on current platform":
+ * callers (test configs, installers) only read this path and hand it back to
+ * launch()/launchServer(), which ignore it on openharmony.
+ *
+ * Order: HDC_BINARY, the Harmonybrew ohos-sdk hdc, hdc on PATH, then the bare
+ * command name (the same last resort HdcBackend uses, so a missing hdc surfaces
+ * later as hdc's own launch error instead of a misleading "Browser is not
+ * supported on current platform").
+ *
+ * The playwright server evaluates executablePath() while it is created, i.e.
+ * on every require of playwright-core, so this only touches the file system —
+ * resolveCommandPath() would spawn login shells.
+ */
+export const ohosExecutablePath = (): string => {
+  if (process.env.HDC_BINARY)
+    return process.env.HDC_BINARY;
+  const harmonybrewHdc = findHarmonybrewHdc();
+  if (harmonybrewHdc)
+    return harmonybrewHdc;
+  for (const dir of (process.env.PATH || '').split(path.delimiter)) {
+    if (!dir)
+      continue;
+    const candidate = path.join(dir, 'hdc');
+    try {
+      fs.accessSync(candidate, fs.constants.X_OK);
+      return candidate;
+    } catch {
+    }
+  }
+  return 'hdc';
+};
