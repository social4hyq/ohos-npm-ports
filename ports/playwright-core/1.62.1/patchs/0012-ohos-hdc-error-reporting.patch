+
+// hdc reports most failures (no device, unauthorized, no connect key) on stdout
+// with exit code 0, so a failed query looks like a normal answer that merely
+// lacks the bundle name. Returns hdc's own message when the answer is a failure.
+const hdcFailureMessage = (result: { stdout: string, stderr: string, code: number }): string | undefined => {
+  const fail = /^\[Fail\].*$/m.exec(result.stdout);
+  if (fail)
+    return fail[0].trim();
+  if (result.code !== 0)
+    return (result.stderr || result.stdout).trim() || `exit code ${result.code}`;
+  return undefined;
+};
+
+const assertBrowserInstalled = async (hdc: HdcBackend, bundleName: string, connectionError?: string): Promise<void> => {
+  if (installedBundlesCache.get(bundleName) === true)
+    return;
+  const { result, failure } = await hdc.shell(`bm dump -n ${bundleName}`).then(
+      result => ({ result, failure: hdcFailureMessage(result) }),
+      error => ({ result: { stdout: '', stderr: '', code: 1 }, failure: String(error?.message ?? error).trim() }));
+  if (failure) {
+    const detail = connectionError && !failure.includes(connectionError) ? ` (device connection check: ${connectionError})` : '';
+    throw new Error(`failed to query browser ${bundleName} on the device with hdc (${hdc.binary}): ${failure}${detail}. ` +
+        `Make sure the device is connected and authorized: \`hdc list targets\` should show Connected.`);
   }
-  if (!installedBundlesCache.get(bundleName))
+  const installed = result.stdout.includes(bundleName);
+  installedBundlesCache.set(bundleName, installed);
+  if (!installed)
     throw new Error(`browser ${bundleName} is not installed on the device`);
 };
 
